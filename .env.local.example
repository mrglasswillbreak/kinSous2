# Vercel Neon PostgreSQL connection string
# Get this from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secret key for session token signing (use a long random string in production)
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Vercel Blob (required for message image uploads)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Web Push (required for push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PUBLIC_KEY=your-public-vapid-key
VAPID_PRIVATE_KEY=your-private-vapid-key
VAPID_SUBJECT=mailto:support@kinsous.com

# Launch configuration
NEXT_PUBLIC_SITE_URL=https://your-staging-domain.example
RESEND_API_KEY=
EMAIL_FROM=KinSous <hello@your-verified-domain.example>
FLW_SECRET_KEY=
FLW_SECRET_HASH=
PAYMENTS_ENABLED=false
FLW_DELAYED_PAYOUT_APPROVED=false
ADMIN_USER_IDS=
CRON_SECRET=
